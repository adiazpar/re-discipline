* text=auto
*.exe binary
*.db binary

# Go sources must be byte-identical on every checkout: the committed exe
# is hash-compared against a CI rebuild, and CRLF conversion would alter
# raw string literals.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# POSIX launcher must keep its shebang and LF endings on Windows checkouts.
bin/re-search text eol=lf
bin/*/re-search binary
