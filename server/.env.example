# Runtime login produced by bootstrap-runtime; never use a publishable key here.
DATABASE_URL=postgresql://re_community_runtime:password@host:5432/postgres?sslmode=verify-full
PUBLIC_URL=http://localhost:8080
# Stable operator UUID and random secret (at least 43 characters).
# Generate securely during deployment; never distribute to readers.
SERVER_OPERATOR_ID=
SERVER_OPERATOR_TOKEN=
TRUSTED_PROXY_IP=
# Optional directory containing backup/restore health timestamps.
OPS_STATUS_DIR=
PORT=8080
CACHE_DIR=.data/search

# Optional automatic review: full chat-completions endpoint, configured model, and its API key.
# Leave unset to use trusted publishers or maintainer review without model charges.
REVIEW_URL=
REVIEW_MODEL=
REVIEW_API_KEY=
MAX_DAILY_MODEL_REVIEWS=200
# Optional typed assistance. Both service setup and the community's assistance
# policy must opt in. Keys alone never enable it; normal workflows need no key.
JEV_ENABLED=false
TYPESAFE_API_KEY=
MAX_DAILY_JEV_REQUESTS=200
MAX_OWNED_COMMUNITIES=5
MAX_TOTAL_COMMUNITIES=50
MAX_COMMUNITY_MEMBERS=100
MAX_DAILY_SUBMISSIONS=100
MAX_COMMUNITY_BYTES=104857600
MAX_TOTAL_CONTENT_BYTES=209715200
MAX_COMMUNITY_FINDINGS=20000
MAX_PENDING_DEVICES=1000
MAX_ACCOUNT_DEVICES=20

# Retrieval capacity is sized automatically from CPU, memory and DB budget.
# Optional overrides; restart after changing resources or these settings.
# MAX_ACTIVE_SEARCHES=8
# MAX_QUEUED_SEARCHES=1024
# MAX_DATABASE_CONNECTIONS=16
# MAX_IN_FLIGHT_REQUESTS=64
# SEARCH_QUEUE_WAIT_MS=10000
# SEARCH_EXECUTION_MS=10000
# GOMEMLIMIT=384MiB
# No MAX_COMMUNITY_ACTIVE_SEARCHES: idle capacity is shared dynamically.
# Only anonymous setup and invalid credentials use this IP abuse limit.
# Authenticated reads have no per-minute credential or shared-IP quota.
MAX_UNAUTHENTICATED_REQUESTS_PER_IP_MINUTE=600
MAX_COMMUNITY_CONNECTIONS=10000
